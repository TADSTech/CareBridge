# Server only. Never use a VITE_ prefix for secret values.
YARNGPT_API_KEY=
# Optional voice ID from your YarnGPT account's voice catalogue. Leave blank to use its default.
YARNGPT_DEFAULT_VOICE=
# Groq powers visible text translations and the English intake draft.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional voice alternatives: Nigerian languages via 9jaLingo; Swahili/English accents via Azure.
NAIJALINGO_API_KEY=
NINEJALINGO_PIDGIN_VOICE=ada_pcm
NINEJALINGO_YORUBA_VOICE=adeola_yo
NINEJALINGO_HAUSA_VOICE=aisha_ha
NINEJALINGO_IGBO_VOICE=adaeze_ig
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_ENGLISH_VOICE=en-NG-EzinneNeural
# Server-only Neon Postgres connection string. Never use a VITE_ prefix.
DATABASE_URL=
# Exposes only the account-enabled UI switch; authentication stays server-side.
VITE_ACCOUNTS_ENABLED=true
API_PORT=3001
